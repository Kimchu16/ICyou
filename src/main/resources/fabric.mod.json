{
    "schemaVersion": 1,
    "id": "icyou",
    "version": "${version}",
    "name": "ICyou",
    "description": "A secure CCTV system with live same-dimension camera feeds, in-game screens, and authenticated remote viewing.",
    "authors": [
        "MatissJurevics"
    ],
    "contact": {
        "homepage": "https://github.com/Kimchu16/ICyou",
        "sources": "https://github.com/Kimchu16/ICyou",
        "issues": "https://github.com/Kimchu16/ICyou/issues"
    },
    "license": "MIT",
    "icon": "assets/icyou/icon.png",
    "environment": "*",
    "mixins": [
        "icyou.mixins.json",
        "icyou.client-mixins.json"
    ],
    "entrypoints": {
        "main": [
            "com.matissjurevics.icyou.ICyouMod"
        ],
        "client": [
            "com.matissjurevics.icyou.client.ICyouClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.9",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
