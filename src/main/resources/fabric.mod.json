{
    "schemaVersion": 1,
    "id": "icyou",
    "version": "${version}",
    "name": "ICyou",
    "description": "ICyou adds a working CCTV surveillance system to Minecraft: place cameras, view their live feed on screens and terminals, cycle channels, and track mobs via network blips. Also adds the Icy and Glacier decorative blocks.",
    "authors": [
        "MatissJurevics"
    ],
    "contact": {
        "homepage": "https://github.com/MatissJurevics/ICyou",
        "sources": "https://github.com/MatissJurevics/ICyou",
        "issues": "https://github.com/MatissJurevics/ICyou/issues"
    },
    "license": "MIT",
    "icon": "assets/icyou/icon.png",
    "environment": "*",
    "mixins": [
        "icyou.client-mixins.json"
    ],
    "entrypoints": {
        "main": [
            "com.matissjurevics.icyou.ICyouMod"
        ],
        "client": [
            "com.matissjurevics.icyou.client.ICyouClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.9",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
